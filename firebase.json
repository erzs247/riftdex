{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json", "**/.*", "**/node_modules/**",
      "images/**", "scripts/**", "cache/**", "raw/**", "dist/**", "pages/**", "_pages/**",
      "*.py", "app.html", "README.md", "requirements.txt", "firestore.rules"
    ],
    "redirects": [
      { "source": "/images/:path*", "destination": "https://erzs247.github.io/riftdex/images/:path", "type": 302 }
    ],
    "headers": [
      { "source": "**/*.@(html|js|css|json|webmanifest)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
